# ============================================================
# UtkForce AI Dashboard — environment template
# Copy: cp .env.example .env   (har service apna .env bhi le sakta hai)
# Kabhi real secrets Git me mat dalo.
# ============================================================

NODE_ENV=development            # development | production | test
PORT=4000

# ---------- Auth (PROD me 32+ bytes random, mandatory) ----------
JWT_ACCESS_SECRET=dev-access-secret-CHANGE-ME-min-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-CHANGE-ME-min-32-chars!!
ACCESS_TOKEN_TTL_SEC=900        # 15 min
REFRESH_TOKEN_TTL_DAYS=30

# ---------- CORS (PROD me exact origin, comma-separated) ----------
CORS_ORIGIN=http://localhost:5173

# ---------- Database ----------
# Khali chhodo => dev file-store (backend/data/db.json). Prod => Postgres:
# DATABASE_URL=postgres://utkforce:STRONGPASS@postgres:5432/utkforce
DATABASE_URL=
SEED_DEMO=true                  # dev me demo user seed karega (prod me false/empty)

# ---------- AI provider ----------
AI_PROVIDER=mock                # mock | openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=mock-1
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=60000

# ---------- File storage ----------
STORAGE_DRIVER=local            # local | s3
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=15
UPLOAD_ALLOWED_MIME=text/plain,text/markdown,application/pdf,image/png,image/jpeg

# S3 (STORAGE_DRIVER=s3 tabhi)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=                   # MinIO/R2 ke liye optional

# ---------- Rate limits (requests / window) ----------
RATE_GLOBAL_PER_MIN=300
RATE_AUTH_PER_MIN=20
RATE_CHAT_PER_MIN=30
RATE_UPLOAD_PER_MIN=20
REDIS_URL=                      # prod me set karo => distributed rate-limit

# ---------- Google login (Phase-2, abhi stub) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---------- Frontend (Vite; VITE_ prefix zaroori) ----------
VITE_API_URL=http://localhost:4000
